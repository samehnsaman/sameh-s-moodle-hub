# --- Database ---
DB_HOST=db
DB_PORT=5432
DB_USER=portfolio
DB_PASSWORD=changeme_strong_password
DB_NAME=portfolio

# Prisma uses DATABASE_URL. Either set it explicitly here, or let
# src/lib/prisma.ts build it from the DB_* vars above.
DATABASE_URL=postgresql://portfolio:changeme_strong_password@db:5432/portfolio?schema=public

# --- API ---
PORT=4000
NODE_ENV=production

# CORS — set to your frontend origin (no trailing slash)
FRONTEND_ORIGIN=http://localhost:5173
