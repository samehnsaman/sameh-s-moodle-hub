# --- Database ---
DB_HOST=db
DB_PORT=5432
DB_USER=portfolio
DB_PASSWORD=changeme_strong_password
DB_NAME=portfolio

# Prisma uses DATABASE_URL. Either set it explicitly here, or let
# src/lib/prisma.ts build it from the DB_* vars above.
DATABASE_URL=postgresql://portfolio:changeme_strong_password@db:5432/portfolio?schema=public

# --- API ---
PORT=4000
NODE_ENV=production

# CORS — set to your frontend origin (no trailing slash). Comma-separated for multiple.
FRONTEND_ORIGIN=http://localhost:5173

# --- Admin auth (JWT) ---
# Single admin account. Generate strong values:
#   ADMIN_PASSWORD: any strong password you'll remember
#   JWT_SECRET:     openssl rand -hex 64
ADMIN_EMAIL=admin@samehnaim.dev
ADMIN_PASSWORD=change_this_to_a_long_strong_password
JWT_SECRET=replace_with_64_byte_random_hex_string
JWT_EXPIRES_IN=12h
