// Prisma schema for the portfolio site.
// Mirrors the TypeScript types in ../src/types/portfolio.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id               String  @id @default(cuid())
  name             String
  location         String
  title            String
  shortBio         String  @db.Text
  longBio          String  @db.Text
  avatarUrl        String  @default("")
  yearsExperience  Int
  email            String
  githubUrl        String?
  linkedinUrl      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Skill {
  id        String  @id @default(cuid())
  name      String
  category  String  // "Moodle & LMS" | "Backend" | "Frontend" | "DevOps & Cloud"
  level     String  // "expert" | "advanced" | "intermediate"
  icon      String  @default("")
  createdAt DateTime @default(now())

  @@index([category])
}

model Service {
  id                  String   @id @default(cuid())
  title               String
  shortDescription    String   @db.Text
  detailedDescription String   @db.Text
  targetClients       String[] // Postgres array
  icon                String   @default("")
  createdAt           DateTime @default(now())
}

model Project {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  shortDescription String   @db.Text
  longDescription  String   @db.Text
  problem          String   @db.Text
  solution         String   @db.Text
  outcomes         String[]
  techStack        String[]
  role             String
  startDate        DateTime
  endDate          DateTime?
  status           String   // "live" | "in progress" | "planned"
  featured         Boolean  @default(false)
  projectType      String   // "Moodle plugin" | "School management system" | "SaaS app" | "WordPress plugin"
  liveUrl          String?
  demoUrl          String?
  githubUrl        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([projectType])
  @@index([featured])
}

model Testimonial {
  id           String   @id @default(cuid())
  quote        String   @db.Text
  author       String
  organization String
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([order])
}

model Plugin {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String   @db.Text
  category     String   @default("Moodle plugin") // "Moodle plugin" | "WordPress plugin" | "Other"
  url          String   // primary link (download / repo / product page)
  repoUrl      String?
  downloadUrl  String?
  version      String?
  iconUrl      String?
  featured     Boolean  @default(false)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([order])
}

model ContactMessage {
  id            String   @id @default(cuid())
  name          String
  email         String
  organization  String?
  projectType   String?
  budgetRange   String?
  message       String   @db.Text
  status        String   @default("new") // "new" | "in_progress" | "closed"
  createdAt     DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}
